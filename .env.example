# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_BOOKS_API_KEY: (Optional) Public requests work without a key, but a key increases rate limits.
GOOGLE_BOOKS_API_KEY="YOUR_GOOGLE_BOOKS_API_KEY"

# FIREBASE CONFIGURATION: (Optional) If omitted, SmartLib AI runs in persistent offline/demo mode with realistic seeded data.
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyPlaceholder"
VITE_FIREBASE_AUTH_DOMAIN="smartlib-ai-demo.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="smartlib-ai-demo"
VITE_FIREBASE_STORAGE_BUCKET="smartlib-ai-demo.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
